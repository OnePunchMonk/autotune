# Copy to .env and fill in. Autotune loads secrets via autotune/config.py,
# which checks .env first and falls back to AWS AppConfig if AUTOTUNE_SECRETS_PROVIDER=appconfig.

ANTHROPIC_API_KEY=sk-ant-...

# Optional: which Claude model drives the agent loop.
AUTOTUNE_AGENT_MODEL=claude-sonnet-5

# Optional: switch secrets provider. "dotenv" (default) or "appconfig".
AUTOTUNE_SECRETS_PROVIDER=dotenv

# Only needed if AUTOTUNE_SECRETS_PROVIDER=appconfig
AWS_APPCONFIG_APPLICATION=autotune
AWS_APPCONFIG_ENVIRONMENT=prod
AWS_APPCONFIG_PROFILE=agent-secrets
AWS_REGION=us-east-1

# Modal: run `modal token set` once locally instead of storing creds here.
